
''''''''''''''''''''''''''''''''''''
' Euclidian algorithm for GCD(p,q)
''''''''''''''''''''''''''''''''''''

int t;
int p;
int q;
int p1;
int q1;

read(p);
read(q);

p1 = p;
q1 = q;

if (q <= p)
then
  skip
else
  {
    t = p;
    p = q;
    q = t;
  };

while (p % q != 0)
  {
    t = p % q;

    p = q;
    q = t;
  };  

write (q);

assert (p1 % q == 0 && q1 % q == 0)